# LibreChat env template untuk Gerai playground deploy
# Copy ini ke .env dan fill nilai-nilai. Atau set di Railway dashboard.

# === REQUIRED — Provider API keys (minimal 1 wajib supaya ada model bisa dipakai) ===

# Anthropic Claude (sama key yang dipakai Gerai PWA)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional, isi kalau mau provider tambahan)
# Get key di https://aistudio.google.com/apikey
GOOGLE_KEY=

# OpenAI GPT (optional, isi kalau mau provider tambahan)
OPENAI_API_KEY=sk-proj-...

# === REQUIRED — Auth + security ===

# JWT secret untuk session token. GENERATE RANDOM 32+ char string.
# Bisa pakai: openssl rand -hex 32  (atau https://generate-random.org/api-key-generator)
JWT_SECRET=ganti-dengan-random-string-min-32-char
JWT_REFRESH_SECRET=ganti-dengan-random-string-min-32-char-beda

# Creds encryption (untuk encrypt API key user kalau multi-user)
CREDS_KEY=ganti-dengan-32-byte-hex-string
CREDS_IV=ganti-dengan-16-byte-hex-string

# === REQUIRED — Database ===

# MongoDB. Railway auto-provision kalau pakai template mereka.
# Kalau self-host: mongodb://localhost:27017/LibreChat
MONGO_URI=mongodb://mongo:27017/LibreChat

# Meilisearch (untuk full-text search history). Optional tapi recommended.
SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=ganti-dengan-random-string-min-16-char

# === OPTIONAL — Akses control ===

# Allow registration. Set false kalau cuma Matthew yang pakai (login pakai admin user).
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false

# Domain server (URL yang user akses). Default localhost; Railway auto-set ke their domain.
DOMAIN_SERVER=https://librechat-mahew.up.railway.app
DOMAIN_CLIENT=https://librechat-mahew.up.railway.app

# Port (Railway override otomatis lewat $PORT)
HOST=0.0.0.0
PORT=3080

# === OPTIONAL — Phase D++ integration dengan Gerai ===

# Bearer token untuk akses endpoint Gerai (sama dengan N8N_WEBHOOK_TOKEN di Vercel Gerai)
# Dipakai kalau Custom Endpoint Atmaja Gerai di-enable di librechat.yaml
GERAI_BEARER_TOKEN=decbcce50261ac5200cca67f66089074422504e204049cc52c5a0eb4243bf26c

# === OPTIONAL — File upload + RAG ===

# Kalau mau enable RAG (chat with files), butuh deploy rag_api separate.
# Skip dulu untuk MVP playground.
# RAG_API_URL=
# RAG_OPENAI_API_KEY=

# === OPTIONAL — Logging ===

DEBUG_LOGGING=false
DEBUG_CONSOLE=false
CONSOLE_JSON=false

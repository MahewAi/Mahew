# === Gerai AI Department — Deploy ENV ===
# Salin file ini jadi .env lalu isi nilainya. JANGAN commit .env yang sudah terisi.

# OpenRouter (otak Claude). Ambil di https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx

# Secret acak untuk sesi Open WebUI.
# Generate di VPS: openssl rand -hex 32
WEBUI_SECRET_KEY=ganti-dengan-string-acak-panjang-64-karakter

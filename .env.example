# Privacy-first defaults.
# Keep privacy lock on unless you intentionally trust the deployment/runtime.
VITE_GERAI_PRIVACY_LOCK=on
VITE_GERAI_AGENT_BRIDGE=off
VITE_GERAI_TELEMETRY=off

# Server-side bridge secrets. These must never be exposed to the browser.
ATMAJA_BRIEF_WEBHOOK_URL=
ATMAJA_BRIDGE_TOKEN=
ATMAJA_WEBHOOK_ALLOWED_HOSTS=
ATMAJA_BRIEF_MAX_BYTES=262144
ATMAJA_BRIDGE_RATE_LIMIT=20
GERAI_ALLOWED_ORIGINS=

# Server-side cost provider keys. Never expose these as VITE_* values.
OPENROUTER_MANAGEMENT_KEY=

# Server-side Atmaja chat bridge. Keep disabled until Matthew explicitly trusts the runtime.
ATMAJA_OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openrouter/auto
ATMAJA_OPENROUTER_MODEL=
ATMAJA_CHAT_MAX_BYTES=32768
ATMAJA_CHAT_RATE_LIMIT=12
ATMAJA_OPENROUTER_REFERER=
